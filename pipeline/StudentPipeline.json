				},
				"inputs": [
					{
						"referenceName": "StudentExcel",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "AzureMySqlTable1",
						"type": "DatasetReference"
					}
				]
			}
		],
		"folder": {
			"name": "Student"
		},
		"annotations": [],
		"lastPublishTime": "2026-06-24T17:09:20Z"
	},
